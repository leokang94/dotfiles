copy-on-select = true

theme = Dracula
#font-family = MonaspiceKr Nerd Font Mono
font-family = MonaspiceXe Nerd Font Mono
font-family = D2Coding

#font-family = Monaspace Krypton Var
#font-family = Monaspace Radon Var
#font-family = Hack Nerd Font Mono
#font-family = Monaspace Xenon Var
#font-family = Monaspace Argon Var
font-size = 14
font-thicken = true

mouse-hide-while-typing = true

cursor-style = block
cursor-style-blink = false

# background-opacity = 0.7
# background-blur-radius = 25

window-padding-y = 0
window-padding-x = 0
window-padding-color = extend
window-padding-balance = true
window-save-state = always
window-colorspace = display-p3

macos-option-as-alt = true
# macos-titlebar-style = hidden

# custom-shader = shaders/better-crt.glsl
# custom-shader = shaders/mnoise.glsl
# custom-shader = shaders/test.glsl
# custom-shader-animation = false
custom-shader = shaders/cursor_smear.glsl

############################################################################
# keybindings
############################################################################

# reload config
keybind = ctrl+g>r=reload_config

# split navigation and manipulation
keybind = ctrl+g>s>s=new_split:auto
keybind = ctrl+g>s>h=new_split:left
keybind = ctrl+g>s>l=new_split:right
keybind = ctrl+g>s>k=new_split:up
keybind = ctrl+g>s>j=new_split:down

keybind = ctrl+cmd+h=goto_split:left
keybind = ctrl+cmd+l=goto_split:right
keybind = ctrl+cmd+k=goto_split:top
keybind = ctrl+cmd+j=goto_split:bottom
keybind = ctrl+cmd+m=toggle_split_zoom

keybind = ctrl+cmd+shift+h=resize_split:left,40
keybind = ctrl+cmd+shift+l=resize_split:right,40
keybind = ctrl+cmd+shift+k=resize_split:up,40
keybind = ctrl+cmd+shift+j=resize_split:down,40
keybind = ctrl+cmd+e=equalize_splits

keybind = ctrl+g>q=toggle_quick_terminal

# inspector
keybind = f12=inspector:toggle



keybind = shift+enter=text:\n
