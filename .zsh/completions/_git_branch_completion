#compdef open-jenkins open-ci pull-request

# Git 브랜치 자동완성 함수
# 여러 커스텀 명령어에서 재사용 가능
_git_branch_completion() {
  local -a branches

  # git 저장소인지 확인
  if git rev-parse --git-dir > /dev/null 2>&1; then
    # 로컬 브랜치 목록 가져오기
    branches=($(git branch --format='%(refname:short)' 2>/dev/null))

    # HEAD 옵션 추가 (현재 브랜치를 의미)
    branches+=('HEAD', '@')

    # 브랜치 목록을 자동완성 옵션으로 제공
    _describe 'branch' branches
  else
    _message 'not a git repository'
  fi
}

# 함수 실행
_git_branch_completion "$@"


