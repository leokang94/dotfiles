{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(*)",
      "Edit(*)",
      "Write(*)",
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "Search(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "Task(*)",
      "Skill(*)",
      "mcp__*"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets.*)",
      "Read(~/Library/Keychains/**)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash -c 'node \"$(find ~/.claude/plugins/cache/claude-hud/claude-hud/ -maxdepth 1 -type d -name \"[0-9]*\" | sort -V | tail -1)/dist/index.js\"'"
  },
  "enabledPlugins": {
    "claude-hud@claude-hud": true,
    "session-wrap@team-attention-plugins": true
  },
  "alwaysThinkingEnabled": true,
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [[ \"$PWD\" == *\"worktree\"* ]] || [[ \"$PWD\" == *\"worktrees\"* ]]; then WORKTREE_NAME=$(basename \"$PWD\"); terminal-notifier -title \"Claude Code - Worktree\" -message \"답변 완료: $WORKTREE_NAME\" -sound default -group \"claude-code-worktree\" -sender com.apple.Terminal; fi",
            "async": true
          }
        ]
      }
    ]
  }
}
