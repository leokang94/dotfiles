{
	"includeCoAuthoredBy": false,
	"permissions": {
		"allow": [
			"Bash(*)",
			"Edit(*)",
			"Write(*)",
			"Read(*)",
			"Glob(*)",
			"Grep(*)",
			"Search(*)",
			"WebFetch(*)",
			"WebSearch(*)",
			"Task(*)",
			"Skill(*)",
			"mcp__*"
		],
		"deny": [
			"Read(./.env)",
			"Read(./.env.*)",
			"Read(./secrets.*)",
			"Read(~/Library/Keychains/**)"
		]
	},
	"alwaysThinkingEnabled": true
}
